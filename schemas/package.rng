<?xml version="1.0" encoding="UTF-8"?>
<!--
  epubveri — EPUB package-document (OPF) schema.

  Authored from scratch for epubveri (copyright the project owner; ships under
  the project's dual AGPL/commercial license). NOT derived from epubcheck's or
  W3C's schema files.

  Deliberately PERMISSIVE: it pins the package skeleton (package > metadata,
  manifest, spine; manifest items carry id/href/media-type; spine itemrefs carry
  idref) but allows any attributes, foreign elements, and loose metadata so it
  does not false-positive on the wide variety of valid real-world packages.
  Finer constraints (required dc metadata, vocabularies, refines) are handled by
  the hand-coded checks today and will move to Schematron later.

  One exception to "allows any attributes": `id`, `idref`, `toc` and `fallback`
  are typed. An XML `id` is an NCName — no spaces, no commas, no apostrophes,
  no colon, and it may not start with a digit — and both `opf20.rng` and
  `package-30.rnc` type them (`xsd:ID`/`xsd:IDREF`). They were plain strings
  here until 2026-09-11, so `<item id="King,_Stephen_-_Gerald's_Game51">` was
  accepted; an external 2,798-book run found 4 such books, 2 of them changing
  verdict. Seven values probed against epubcheck 5.3.0, one book each, on both
  versions.

  Only the *lexical* half is here. `ID`'s uniqueness is a separate question and
  stays with the hand-coded duplicate-id checks.

  Nothing on the 474-book shelf moves: of **55,913** `id`/`idref` values in its
  474 packages, every one is already a valid XML name.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:opf="http://www.idpf.org/2007/opf"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         ns="http://www.idpf.org/2007/opf"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <element name="package">
      <ref name="anyAttributes"/>
      <attribute name="version"><data type="string"/></attribute>
      <interleave>
        <element name="metadata"><ref name="metadataContent-epub3"/></element>
        <element name="manifest">
          <ref name="anyAttributes"/>
          <oneOrMore>
            <choice>
              <element name="item">
                <ref name="anyAttributes"/>
                <attribute name="id"><data type="ID"/></attribute>
                <attribute name="href"><data type="string"/></attribute>
                <attribute name="media-type"><data type="string"/></attribute>
              </element>
              <ref name="foreignElement"/>
            </choice>
          </oneOrMore>
        </element>
        <element name="spine">
          <ref name="anyAttributes"/>
          <oneOrMore>
            <choice>
              <element name="itemref">
                <ref name="anyAttributes"/>
                <attribute name="idref"><data type="IDREF"/></attribute>
              </element>
              <ref name="foreignElement"/>
            </choice>
          </oneOrMore>
        </element>
        <!-- guide, collection, bindings, foreign top-level children -->
        <zeroOrMore><ref name="otherPackageChild"/></zeroOrMore>
      </interleave>
    </element>
  </start>

  <!-- any attribute, any namespace -->
  <define name="anyAttributes">
    <zeroOrMore><attribute><anyName/></attribute></zeroOrMore>
  </define>

  <!-- fully permissive mixed content: any attributes, any child elements, text -->
  <define name="looseContent">
    <ref name="anyAttributes"/>
    <mixed><zeroOrMore><ref name="anyElement"/></zeroOrMore></mixed>
  </define>

  <!-- EPUB 3 `<metadata>`. Everything here except the Dublin Core elements
       stays as permissive as `looseContent` - `<meta>`, `<link>` and foreign
       elements are unconstrained, and so is any dc-namespace element outside
       the fifteen below, because *which* dc elements may appear is a separate
       question from what attributes they take and tightening it here would
       bundle two changes.

       The fifteen are constrained because a legacy OPF 2 package converted to
       EPUB 3 keeps `opf:role`, `opf:file-as`, `opf:scheme` and `opf:event` on
       them, and EPUB 3 replaced all of that with `<meta refines>`.
       `package-30.rnc` gives them one of exactly two attribute lists, and
       nothing else:

         opf.dc.attlist = opf.id.attr? & opf.i18n.attrs   (id, dir, xml:lang)
         …and identifier/language/date/type/format take `opf.id.attr?` alone.

       That second group is the easy one to get wrong: `xml:lang` on
       `dc:language` is an error, on `dc:title` it is not. Both halves were
       probed against epubcheck 5.3.0, one attribute per book, on a minimal
       book that is otherwise clean in both tools.

       Reported by a MobileRead user (thread page 13) with epubcheck's output
       and ours side by side: 13 findings against our 7, and all six missing
       were this. No book on the 336-book shelf carries an `opf:*` attribute
       on a dc element, so nothing here is shelf-visible in either direction -
       the probe and the tests are the whole evidence. -->
  <define name="metadataContent-epub3">
    <ref name="anyAttributes"/>
    <mixed>
      <zeroOrMore>
        <choice>
          <ref name="dcFull-epub3"/>
          <ref name="dcIdOnly-epub3"/>
          <ref name="otherDcElement"/>
          <ref name="metaOrLinkEl-epub3"/>
        </choice>
      </zeroOrMore>
    </mixed>
  </define>

  <!-- `id`, `dir` and `xml:lang`. `dir`'s value set is epubcheck's
       (`opf.dir.attr`), not a free string. -->
  <define name="dcFull-epub3">
    <element>
      <choice>
        <name>dc:title</name>
        <name>dc:source</name>
        <name>dc:creator</name>
        <name>dc:subject</name>
        <name>dc:description</name>
        <name>dc:publisher</name>
        <name>dc:contributor</name>
        <name>dc:relation</name>
        <name>dc:coverage</name>
        <name>dc:rights</name>
      </choice>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <optional>
        <attribute name="dir">
          <choice><value>ltr</value><value>rtl</value><value>auto</value></choice>
        </attribute>
      </optional>
      <optional><attribute name="xml:lang"><data type="string"/></attribute></optional>
      <text/>
    </element>
  </define>

  <!-- `id` and nothing else. -->
  <define name="dcIdOnly-epub3">
    <element>
      <choice>
        <name>dc:identifier</name>
        <name>dc:language</name>
        <name>dc:date</name>
        <name>dc:type</name>
        <name>dc:format</name>
      </choice>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <text/>
    </element>
  </define>

  <!-- EPUB 3 `<metadata>` holds the fifteen Dublin Core elements, `<meta>` and
       `<link>`, and **nothing else** - `opf.metadata.content = opf.dc.elems &
       opf.meta* & opf.link*` (`package-30.rnc`:20). Not "foreign elements are
       allowed here", which is the natural assumption and is wrong: probed
       against epubcheck 5.3.0, a properly namespaced `<x:thing
       xmlns:x="http://example.org/x">` is RSC-005 there, and so are
       `<meta xmlns="" name="BNContentKind" content="book"/>` and a
       no-namespace `<BNContentKind>`. The last of those is what an external
       2,798-book run found us accepting, 1 book and a verdict.

       **EPUB 2 is the opposite and stays loose**: `opf20.rng` has
       `OPF20.any-other-element`, and all four shapes above are clean there in
       both tools - measured the same way. So this constrains the EPUB 3 model
       only.

       What is tightened here is the *namespace*, not the vocabulary: an
       unrecognized element in the DC namespace is still accepted, keeping the
       deliberate split recorded above ("which dc elements may appear is a
       separate question"). epubcheck would reject one; closing that is its own
       change with its own evidence.

       0 of the shelf's 74 EPUB 3 packages - and 0 of its 390 EPUB 2 ones -
       carry a metadata child that is not a dc element, a `<meta>` or a
       `<link>`. -->
  <define name="metaOrLinkEl-epub3">
    <element>
      <choice><name>meta</name><name>link</name></choice>
      <ref name="looseContent"/>
    </element>
  </define>

  <!-- A DC-namespace element that is not one of the fifteen: still fully
       permissive, on the split described above. -->
  <define name="otherDcElement">
    <element>
      <nsName ns="http://purl.org/dc/elements/1.1/">
        <except>
          <name>dc:title</name>
          <name>dc:source</name>
          <name>dc:creator</name>
          <name>dc:subject</name>
          <name>dc:description</name>
          <name>dc:publisher</name>
          <name>dc:contributor</name>
          <name>dc:relation</name>
          <name>dc:coverage</name>
          <name>dc:rights</name>
          <name>dc:identifier</name>
          <name>dc:language</name>
          <name>dc:date</name>
          <name>dc:type</name>
          <name>dc:format</name>
        </except>
      </nsName>
      <ref name="looseContent"/>
    </element>
  </define>

  <define name="anyElement">
    <element><anyName/><ref name="looseContent"/></element>
  </define>

  <define name="foreignElement">
    <element>
      <anyName><except><nsName ns="http://www.idpf.org/2007/opf"/></except></anyName>
      <ref name="looseContent"/>
    </element>
  </define>

  <!-- The other real package children, plus any element from a *different*
       namespace (a vendor extension) - an unrecognized OPF-namespaced
       element (confirmed via a real fixture, a stray <hello/>) is a real
       content-model violation, not something to stay permissive about.

       `tours` was previously left out on the grounds that no corpus fixture
       exercises it. That was the wrong test (#58): epubcheck's `opf20.rng`
       lists it explicitly in `OPF20.package-content` - metadata, manifest,
       spine, optional tours, optional guide - so a legacy EPUB 2 book using
       it is valid and we were rejecting it. The corpus not covering
       something says nothing about whether the schema allows it.

       Like `bindings`/`collection` (EPUB 3-only) it is accepted regardless
       of version: this grammar has no version switch, and being permissive
       about a legacy element in EPUB 3 costs a missed error, where the
       reverse cost a wrong one. -->
  <define name="otherPackageChild">
    <choice>
      <element name="guide">
        <!-- must have at least one <reference> (confirmed via a real
             fixture, an empty <guide></guide>), and the child is named.

             **The child used to be `anyElement`, and that was a false
             negative** (JSWolf, MobileRead #254): `<guide><referen/>…</guide>`
             validated here and draws `element "referen" not allowed anywhere;
             expected element "reference"` from epubcheck. Both grammars name
             it - `OPF20.guide-content` is `oneOrMore reference-element` and
             `package-30.rnc` has `opf.guide = element guide { opf.reference+ }`
             - so this is right at either version.

             The comment that justified `anyElement` said naming the child
             "would duplicate a violation the surrounding grammar already
             reports". Nothing did. That is the same shape as the silent-skip
             family: one check defers to another that does not cover the case,
             and the gap reports nothing at all. -->
        <ref name="anyAttributes"/>
        <oneOrMore>
          <element name="reference"><ref name="looseContent"/></element>
        </oneOrMore>
      </element>
      <element name="bindings"><ref name="looseContent"/></element>
      <element name="collection"><ref name="looseContent"/></element>
      <!-- must have at least one <tour> (JSWolf, MobileRead #234; issue #87).
           `opf20.rng`'s `OPF20.tours-content` is `oneOrMore tour-element`, so
           an empty <tours></tours> is an error there and was accepted here.
           #58 added the element's *existence* and stopped; a permissive
           placeholder in a grammar is not local to the element it is on, and
           this is the second time that has cost a finding (see `mapEl`). The
           child is `anyElement` rather than `tour` by name for the same
           reason `guide` above uses it: the cardinality is the finding, and
           naming the child would duplicate a violation the surrounding
           grammar already reports. -->
      <element name="tours">
        <ref name="anyAttributes"/>
        <oneOrMore>
          <!-- and a <tour> holds <site> elements, `OPF20.tour-content`. Found
               by the same probe as the child-name fix above: with the name
               corrected, a *well-formed* `<tours><tour title="t"/></tours>`
               still drew `element "tour" incomplete; missing required element
               "site"` from epubcheck and nothing from us. One tightening
               exposing the next is the pattern here - close the neighbourhood,
               not the case. -->
          <element name="tour">
            <ref name="anyAttributes"/>
            <oneOrMore>
              <element name="site"><ref name="looseContent"/></element>
            </oneOrMore>
          </element>
        </oneOrMore>
      </element>
      <ref name="foreignElement"/>
    </choice>
  </define>

  <!-- ============================================================ -->
  <!-- EPUB 2 (OPF 2.0.1) package document.                          -->
  <!--                                                               -->
  <!-- The grammar above is deliberately permissive and has no        -->
  <!-- version switch, which meant an EPUB 2 package was checked      -->
  <!-- against EPUB 3's rules. epubcheck validates one against a      -->
  <!-- *closed* grammar (schema/20/rng/opf20.rng), and the difference -->
  <!-- accounted for four of the eleven findings we were missing on a -->
  <!-- mislabelled book (issue #63; DNSB, MobileRead #134).           -->
  <!--                                                               -->
  <!-- Scoped to the three element shapes that evidence covers:       -->
  <!-- `meta`, `item`, `itemref`. The metadata *element pool* is left -->
  <!-- as permissive as before on purpose - that is where real EPUB 2 -->
  <!-- books vary most (legacy `dc-metadata`/`x-metadata` forms,      -->
  <!-- vendor extensions), so it is where a false positive would come -->
  <!-- from, and no evidence asked for it.                            -->
  <!--                                                               -->
  <!-- `spine@toc` is required by opf20 too, but stays out of here:   -->
  <!-- a hand-coded check already reports it, and both would double.  -->
  <!-- `<package>`'s attribute list is CLOSED here (JSWolf, MobileRead     -->
  <!-- #236; issue #90). `OPF20.package-element` is exactly `version`,      -->
  <!-- `unique-identifier` and an optional `id`, and we granted             -->
  <!-- `anyAttributes` - so an EPUB 3 attribute in a 2.0 package, and the   -->
  <!-- reported `xml:lang`, both passed silently.                          -->
  <!--                                                                     -->
  <!-- Two of epubcheck's three constraints stay OUT of the grammar to      -->
  <!-- avoid doubling a hand-coded check: `unique-identifier` is optional   -->
  <!-- here because its requiredness is reported in `opf.rs`, and           -->
  <!-- `version`'s value is checked there too. What this adds is the list.  -->
  <!--                                                                     -->
  <!-- Measured before shipping, on all 312 EPUB 2 books of the 385-book    -->
  <!-- shelf: 310 carry nothing beyond these three, 2 carry `prefix` (an    -->
  <!-- EPUB 3 attribute, which epubcheck rejects for the same reason), and  -->
  <!-- NONE carries `xml:lang` - so the shelf cannot vouch for the reported -->
  <!-- case and the grammar is the evidence.                                -->
  <define name="packageEl-epub2">
    <element name="package">
      <attribute name="version"><data type="string"/></attribute>
      <optional><attribute name="unique-identifier"><data type="IDREF"/></attribute></optional>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <interleave>
        <element name="metadata"><ref name="metadataContent-epub2"/></element>
        <element name="manifest">
          <ref name="anyAttributes"/>
          <oneOrMore>
            <choice>
              <ref name="itemEl-epub2"/>
              <ref name="foreignElement"/>
            </choice>
          </oneOrMore>
        </element>
        <element name="spine">
          <!-- OPF 2.0.1's spine attlist (epubcheck schema/20/rng/opf20.rng)
               is exactly optional `id` plus `toc` - not the EPUB 3 wildcard.
               `page-progression-direction` is an EPUB 3 addition and drew
               nothing from us in a 2.0 package until 2026-08-04, found in a
               MobileRead #148 output diff and confirmed against epubcheck
               locally. `toc`'s *requiredness* is deliberately not encoded
               here; a missing one is reported by its own check. -->
          <optional><attribute name="id"><data type="ID"/></attribute></optional>
          <optional><attribute name="toc"><data type="IDREF"/></attribute></optional>
          <oneOrMore>
            <choice>
              <ref name="itemrefEl-epub2"/>
              <ref name="foreignElement"/>
            </choice>
          </oneOrMore>
        </element>
        <zeroOrMore><ref name="otherPackageChild"/></zeroOrMore>
      </interleave>
    </element>
  </define>

  <!-- Everything the permissive metadata model allowed, except that an
       OPF-namespace <meta> must now be the EPUB 2 shape. -->
  <!-- EPUB 2 `<metadata>`. The Dublin Core elements carry a per-element
       attribute list, everything else stays as loose as it was.

       `opf20.rng` gives the fifteen five different lists, and the differences
       are not decorative - `opf:file-as` is legal on `dc:creator` and an error
       on `dc:title`, `xml:lang` is legal on `dc:title` and an error on
       `dc:language`. All of it is namespaced: `<dc:creator file-as="..."
       role="aut">` with no prefix is an error, because these attributes live
       in the OPF namespace and a no-namespace attribute is a different
       attribute.

       This was `looseContent` until 2026-09-11, so the whole class was missed:
       an external 2,798-book run reported 9 books where epubcheck errors and we
       were silent. Five shapes probed against 5.3.0, one book each - a
       `file-as` on `dc:title`, an unprefixed `file-as`/`role` pair, an
       `xml:lang` on `dc:language`, an `opf:role` on `dc:publisher` and an
       `opf:file-as` on `dc:subject` are each RSC-005 there; a properly
       prefixed `dc:creator` pair and a `dc:date opf:event` are clean.

       **Safe to tighten, and measured rather than assumed**: of the 474-book
       shelf, 390 packages are EPUB 2 and 385 of them put an attribute other
       than `id`/`xml:lang` on a Dublin Core element - but resolving prefixes
       to namespaces, **not one of those is disallowed**. A prefix census says
       the opposite (`ns0:role`, `ns3:scheme` and friends look foreign and are
       the same attributes under another prefix), which is why the scan that
       decided this resolves namespaces. -->
  <!-- **Either the legacy wrappers or the plain elements, never both.**
       `OPF20.metadata-content` is a `<choice>` of two interleaves: a required
       `<dc-metadata>` with an optional `<x-metadata>` beside it, *or* the
       Dublin Core elements written directly. epubcheck reports a book that
       mixes them (RSC-005, `element "dc-metadata" not allowed here`); we
       accepted the wrapper anywhere, which an external 2,798-book run found on
       2 books.

       The wrappers' own contents stay loose - that is OEBPS 1.2's vocabulary
       and a separate question, the same line drawn for OPF-047. What is
       enforced here is only the either/or.

       0 of the shelf's 390 EPUB 2 packages use a wrapper at all. -->
  <define name="metadataContent-epub2">
    <ref name="anyAttributes"/>
    <choice>
      <ref name="legacyMetadata-epub2"/>
      <ref name="modernMetadata-epub2"/>
    </choice>
  </define>

  <define name="legacyMetadata-epub2">
    <mixed>
      <interleave>
        <element name="dc-metadata"><ref name="looseContent"/></element>
        <optional>
          <element name="x-metadata"><ref name="looseContent"/></element>
        </optional>
      </interleave>
    </mixed>
  </define>

  <define name="modernMetadata-epub2">
    <mixed>
      <zeroOrMore>
        <choice>
          <ref name="metaEl-epub2"/>
          <ref name="dcCommon-epub2"/>
          <ref name="dcAgent-epub2"/>
          <ref name="dcIdentifier-epub2"/>
          <ref name="dcTyped-epub2"/>
          <ref name="dcDate-epub2"/>
          <ref name="nonDcOrMetaElement-epub2"/>
        </choice>
      </zeroOrMore>
    </mixed>
  </define>

  <!-- The generic branch must EXCLUDE the fifteen, or the choice above makes
       the constraint vacuous: a `<dc:title opf:file-as>` would simply match
       here instead. Same reason `nonDcElement` carries the list on the EPUB 3
       side. `meta` is excluded too, as before, so `metaEl-epub2` owns it. -->
  <define name="nonDcOrMetaElement-epub2">
    <element>
      <anyName>
        <except>
        <name>meta</name>
        <!-- Excluded so the modern branch cannot absorb a legacy wrapper and
             make the choice above vacuous. -->
        <name>dc-metadata</name>
        <name>x-metadata</name>
        <name>dc:title</name>
        <name>dc:source</name>
        <name>dc:creator</name>
        <name>dc:subject</name>
        <name>dc:description</name>
        <name>dc:publisher</name>
        <name>dc:contributor</name>
        <name>dc:relation</name>
        <name>dc:coverage</name>
        <name>dc:rights</name>
        <name>dc:identifier</name>
        <name>dc:language</name>
        <name>dc:date</name>
        <name>dc:type</name>
        <name>dc:format</name>
        </except>
      </anyName>
      <ref name="looseContent"/>
    </element>
  </define>

  <!-- `id` and `xml:lang`. -->
  <define name="dcCommon-epub2">
    <element>
      <choice>
        <name>dc:title</name>
        <name>dc:coverage</name>
        <name>dc:description</name>
        <name>dc:publisher</name>
        <name>dc:relation</name>
        <name>dc:rights</name>
        <name>dc:source</name>
        <name>dc:subject</name>
      </choice>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <optional><attribute name="xml:lang"><data type="string"/></attribute></optional>
      <text/>
    </element>
  </define>

  <!-- The two that name a person: `opf:file-as` and `opf:role` as well. -->
  <define name="dcAgent-epub2">
    <element>
      <choice>
        <name>dc:creator</name>
        <name>dc:contributor</name>
      </choice>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <optional><attribute name="xml:lang"><data type="string"/></attribute></optional>
      <optional><attribute name="opf:file-as"><data type="string"/></attribute></optional>
      <optional><attribute name="opf:role"><data type="string"/></attribute></optional>
      <text/>
    </element>
  </define>

  <!-- `opf:scheme` is the identifier's alone. -->
  <define name="dcIdentifier-epub2">
    <element>
      <name>dc:identifier</name>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <optional><attribute name="xsi:type"><data type="string"/></attribute></optional>
      <optional><attribute name="opf:scheme"><data type="string"/></attribute></optional>
      <text/>
    </element>
  </define>

  <!-- `xsi:type` but no `xml:lang`: these hold codes, not prose. -->
  <define name="dcTyped-epub2">
    <element>
      <choice>
        <name>dc:language</name>
        <name>dc:type</name>
        <name>dc:format</name>
      </choice>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <optional><attribute name="xsi:type"><data type="string"/></attribute></optional>
      <text/>
    </element>
  </define>

  <!-- `opf:event` is the date's alone. -->
  <define name="dcDate-epub2">
    <element>
      <name>dc:date</name>
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <optional><attribute name="xsi:type"><data type="string"/></attribute></optional>
      <optional><attribute name="opf:event"><data type="string"/></attribute></optional>
      <text/>
    </element>
  </define>

  <!-- opf20: `name` and `content` are required; `id`, `xml:lang` and
       `scheme` are the only other attributes; the element is empty. An
       EPUB 3 `<meta property="…">value</meta>` fails all three ways, which
       is exactly what epubcheck reports on such a book. -->
  <define name="metaEl-epub2">
    <element name="meta">
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <optional><attribute name="xml:lang"><data type="string"/></attribute></optional>
      <optional><attribute name="scheme"><data type="string"/></attribute></optional>
      <attribute name="name"><data type="string"/></attribute>
      <attribute name="content"><data type="string"/></attribute>
      <empty/>
    </element>
  </define>

  <!-- opf20's closed attribute list. Note the absence of `properties`:
       it is EPUB 3's, and only the EPUB 3 handler parses it. -->
  <define name="itemEl-epub2">
    <element name="item">
      <attribute name="id"><data type="ID"/></attribute>
      <attribute name="href"><data type="string"/></attribute>
      <attribute name="media-type"><data type="string"/></attribute>
      <optional><attribute name="fallback"><data type="IDREF"/></attribute></optional>
      <optional><attribute name="fallback-style"><data type="string"/></attribute></optional>
      <optional><attribute name="required-namespace"><data type="string"/></attribute></optional>
      <optional><attribute name="required-modules"><data type="string"/></attribute></optional>
      <empty/>
    </element>
  </define>

  <define name="itemrefEl-epub2">
    <element name="itemref">
      <optional><attribute name="id"><data type="ID"/></attribute></optional>
      <attribute name="idref"><data type="IDREF"/></attribute>
      <optional>
        <attribute name="linear"><choice><value>yes</value><value>no</value></choice></attribute>
      </optional>
      <empty/>
    </element>
  </define>

</grammar>
